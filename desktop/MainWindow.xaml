<Window x:Class="ForeverFlip.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Icon="/ForeverFlip;component/Assets/ForeverFlip.ico" Title="Forever Flip" Width="760" Height="520" MinWidth="620" MinHeight="480"
 WindowStartupLocation="CenterScreen" Background="#181C18" Foreground="#EEE7D8"
 FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="57" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Gold" Color="#DFC583"/>
  <SolidColorBrush x:Key="Muted" Color="#ADB5A1"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/></Style>
  <Style x:Key="StatusMessage" TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="Foreground" Value="#E9D7AA"/><Setter Property="FontSize" Value="19"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="Background" Value="#2A3025"/><Setter Property="BorderBrush" Value="#75664A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E3BD6E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFE1A3"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#8B2A20" Offset="0"/><GradientStop Color="#531710" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter Property="Foreground" Value="#F2DDA9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="#A98B56"/></Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="0,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Link}"><Setter Property="Padding" Value="3,13"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,24,0"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><Trigger Property="Tag" Value="selected"><Setter Property="Foreground" Value="{StaticResource Gold}"/><Setter Property="BorderBrush" Value="#C9A45D"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="20"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#505540"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="#20261E"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEE7D8"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,5,0,10"/></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="11"/><Setter Property="Background" Value="#181C18"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" Padding="2,3"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#60674F" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#B39B64"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border BorderBrush="#8A7855" BorderThickness="2" Padding="5" Background="#272A21">
  <Grid Background="#181C18"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border BorderBrush="#766247" BorderThickness="0,0,0,1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#312D21"/><GradientStop Color="#1D211A" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid Margin="22,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image x:Name="BrandImage" Source="/ForeverFlip;component/Assets/ForeverFlip.png" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="ForeverFlip"/>
     <TextBlock Grid.Column="1" Text="Forever Flip" Margin="14,0,0,0" FontFamily="Georgia" FontSize="26" Foreground="#EFD28A" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button x:Name="MinimizeButton" Content="−" Width="33" Padding="0" MinHeight="30" Background="Transparent" BorderBrush="Transparent" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
      <Button x:Name="MaximizeButton" Content="□" Width="33" Padding="0" MinHeight="30" Background="Transparent" BorderBrush="Transparent" ToolTip="Maximize or restore" AutomationProperties.Name="Maximize or restore"/>
      <Button x:Name="CloseButton" Content="×" Width="29" MinHeight="28" Padding="0" Margin="8,0,0,0" Style="{StaticResource Primary}" FontSize="20" ToolTip="Close to system tray" AutomationProperties.Name="Close to system tray"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Row="1" BorderBrush="#50523D" BorderThickness="0,0,0,1" Background="#1C211A"><DockPanel Margin="26,0"><Button x:Name="MarketButton" DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Market website ↗" HorizontalAlignment="Right" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal"><Button x:Name="OverviewTab" Content="Home" Tag="selected" Style="{StaticResource Tab}"/><Button x:Name="ProfitTab" Content="Profit &amp; loss" Style="{StaticResource Tab}"/><Button x:Name="SettingsTab" Content="Settings" Style="{StaticResource Tab}"/><Button x:Name="PatchNotesTab" Content="Patch notes" Style="{StaticResource Tab}"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="2">
    <Grid x:Name="OverviewPage" Margin="22,12,22,10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="14,8" Background="#283022" BorderBrush="#646047">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="syncBadge" Text="•" FontSize="26" Foreground="#BDD2A4" VerticalAlignment="Center" Margin="0,0,14,0"/>
       <StackPanel Grid.Column="1"><TextBlock x:Name="statusHeadline" FontSize="17" FontWeight="SemiBold" Text="Waiting for your game"/>
        <TextBlock x:Name="overviewSyncStatus" Style="{StaticResource Hint}" MaxHeight="38" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,ElementName=status}"/>
       </StackPanel>
      </Grid>
     </Border>
     <Grid Grid.Row="1" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock Text="LAST GAME SAVE" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="saveStatus" Text="Not read yet" Margin="0,4,0,0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,10,0"><TextBlock Text="LAST UPLOAD" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="uploadStatus" Text="Not uploaded yet" Margin="0,4,0,0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="SAVED DATA" Style="{StaticResource Eyebrow}"/><TextBlock Margin="0,4,0,0" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><Run x:Name="itemCount" Text="—"/> items · <Run x:Name="observationCount" Text="—"/> prices</TextBlock></StackPanel>
     </Grid>
     <Button x:Name="ResearchStatusButton" Grid.Row="2" Style="{StaticResource Link}" Padding="0,4" Margin="0,3,0,0" ToolTip="{Binding Text,ElementName=packStatus}" AutomationProperties.Name="Research status and details">
      <StackPanel Orientation="Horizontal">
       <TextBlock x:Name="researchDot" Text="●" FontSize="15" Foreground="#ADB5A1" Margin="0,0,9,0" VerticalAlignment="Center"/>
       <TextBlock x:Name="researchIndicator" Text="No current research pack" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Button>
     <StackPanel Grid.Row="3" Margin="0,8,0,0" VerticalAlignment="Bottom">
      <DockPanel><Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Sync now" Margin="10,0,0,0" Padding="14,8" ToolTip="Sync the latest game save. Unsaved scans stay in the game."/><Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Update addon now" Padding="14,8" Margin="12,0,0,0" ToolTip="Install the latest signed addon. Wait for Ready, then /reload for compatible updates."/><StackPanel VerticalAlignment="Center"><TextBlock x:Name="installationStatus" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="12" Foreground="{StaticResource Gold}">Addon <Run x:Name="addonVersion"/> · App <Run x:Name="desktopVersion"/></TextBlock></StackPanel></DockPanel>
      <TextBlock x:Name="overviewUpdateStatus" Text="" Style="{StaticResource StatusMessage}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="ProfitPage" Visibility="Collapsed" Margin="22,12,22,10">
     <Grid.Resources>
      <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="ColumnWidth" Value="*"/><Setter Property="FontSize" Value="12"/><Setter Property="RowBackground" Value="#20261E"/><Setter Property="AlternatingRowBackground" Value="#283022"/><Setter Property="Background" Value="#181C18"/><Setter Property="Foreground" Value="#EEE7D8"/><Setter Property="BorderBrush" Value="#505540"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
      <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#30372B"/><Setter Property="Foreground" Value="#EFD28A"/><Setter Property="Padding" Value="4,7"/></Style>
      <Style TargetType="DataGridCell"><Setter Property="Padding" Value="4,6"/><Setter Property="BorderThickness" Value="0"/></Style>
      <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style>
     </Grid.Resources>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel><ComboBox x:Name="ProfitPeriod" DockPanel.Dock="Right" Width="100" SelectedIndex="1"><ComboBoxItem Content="Today"/><ComboBoxItem Content="7 days"/><ComboBoxItem Content="30 days"/></ComboBox><ComboBox x:Name="ProfitCharacter" Margin="0,0,12,0" MaxWidth="520" HorizontalAlignment="Left" MinWidth="200"/></DockPanel>
     <TextBlock x:Name="ProfitStatus" Grid.Row="1" Style="{StaticResource Hint}" FontSize="11" LineHeight="14" MaxHeight="42" TextTrimming="WordEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Margin="0,8,0,8" Text="Private local totals appear after the addon records a new game save."/>
     <DataGrid x:Name="ProfitTotals" Grid.Row="2" MinColumnWidth="60" RowHeight="23" ColumnHeaderHeight="28"><DataGrid.Columns>
      <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" Width="1.2*" MinWidth="86"/>
      <DataGridTextColumn Header="Spent" Binding="{Binding SpentText}" SortMemberPath="Spent" MinWidth="68"/>
      <DataGridTextColumn Header="Sale income" Binding="{Binding MadeText}" SortMemberPath="Made" MinWidth="82"/>
      <DataGridTextColumn Header="Realized" Binding="{Binding ProfitText}" SortMemberPath="Profit" MinWidth="86"/>
      <DataGridTextColumn Header="Unpriced" Binding="{Binding Unknown}" SortMemberPath="Unknown" Width="0.8*" MinWidth="64"/>
      <DataGridTextColumn Header="Unsold units / cost" Binding="{Binding StockText}" SortMemberPath="Cost" Width="1.6*" MinWidth="132"/>
     </DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="3" Text="DAILY ACTIVITY · UTC" Style="{StaticResource Eyebrow}" Margin="0,12,0,7"/>
     <DataGrid x:Name="ProfitDaily" Grid.Row="4" MinColumnWidth="60"><DataGrid.Columns>
      <DataGridTextColumn Header="UTC day" Binding="{Binding Day}" MinWidth="88"/><DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" MinWidth="84"/>
      <DataGridTextColumn Header="Spent" Binding="{Binding SpentText}" SortMemberPath="Spent" MinWidth="68"/><DataGridTextColumn Header="Sale income" Binding="{Binding MadeText}" SortMemberPath="Made" MinWidth="82"/>
      <DataGridTextColumn Header="Realized" Binding="{Binding ProfitText}" SortMemberPath="Profit" MinWidth="86"/><DataGridTextColumn Header="Unpriced" Binding="{Binding Unknown}" SortMemberPath="Unknown" MinWidth="64"/>
     </DataGrid.Columns></DataGrid>
    </Grid>
    <ScrollViewer x:Name="PatchNotesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="PatchNotesContent" Margin="24,16,24,18"/></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="22,6,22,3">
      <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="Game" Style="{StaticResource Heading}" Margin="0,0,0,7"/>
       <TextBlock x:Name="pathStatus" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Margin="0,0,0,9"/>
       <WrapPanel><Button x:Name="ChooseFolderButton" Content="Choose WoW folder" Margin="0,0,8,4"/><Button x:Name="RepairButton" Content="Repair addon" Margin="0,0,8,4"/><Button x:Name="SettingsUpdateButton" Content="Check app updates" Margin="0,0,0,4"/></WrapPanel>
       <TextBlock x:Name="updateStatus" Style="{StaticResource StatusMessage}" Text="" Margin="0,3,0,0"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="Sharing" Style="{StaticResource Heading}" Margin="0,0,0,6"/>
       <CheckBox x:Name="sharing" Content="Share market data" Margin="0,0,0,3"/>
       <TextBlock Text="Scans, recipes, vendor prices and anonymous check outcomes. No names, inventory or personal transactions. Downloads work with sharing off." Style="{StaticResource Hint}"/>
       <TextBlock x:Name="supportStatus" Text="Use Report issue / feedback in addon Settings for private support." Style="{StaticResource Hint}" Margin="0,3,0,0" FontSize="11" LineHeight="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,5"><DockPanel>
       <CheckBox x:Name="startup" Content="Start with Windows" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"/>
       <StackPanel><TextBlock Text="Automatic sync &amp; updates" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/><TextBlock Text="Checks saved scans every 30 seconds after /reload or logout." Style="{StaticResource Hint}"/></StackPanel>
      </DockPanel></Border>
      <Expander x:Name="TechnicalStatus" Header="Technical status" Foreground="{StaticResource Gold}" Margin="3,0,0,0">
       <StackPanel Margin="10,7,10,4"><TextBlock x:Name="status" Style="{StaticResource Hint}"/><TextBlock x:Name="loadedAddonStatus" Style="{StaticResource Hint}" Margin="0,7,0,0"/><TextBlock x:Name="packStatus" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="3" BorderBrush="#4B513B" BorderThickness="0,1,0,0" Background="#151B14" Padding="19,10"><DockPanel><TextBlock x:Name="sharingStatus" DockPanel.Dock="Right" Style="{StaticResource Hint}" FontSize="11" Margin="15,0,0,0" Foreground="#BED2A3" Text="Market sharing enabled"/><TextBlock x:Name="marketStatus" Style="{StaticResource Hint}" Text="WoW Forever beta" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  </Grid>
 </Border>
</Window>
